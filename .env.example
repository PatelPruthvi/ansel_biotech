# EmailJS — copy to `.env` and fill with real IDs from the EmailJS dashboard.
# `.env` is gitignored; this file is safe to commit.

VITE_EMAILJS_PUBLIC_KEY=your_public_key_here

# Contact form (/contact — Get in Touch)
VITE_EMAILJS_CONTACT_SERVICE_ID=service_contact_demo
VITE_EMAILJS_CONTACT_TEMPLATE_ID=template_contact_demo

# Quote request modal (Send Quote Request)
VITE_EMAILJS_QUOTE_SERVICE_ID=service_quote_demo
VITE_EMAILJS_QUOTE_TEMPLATE_ID=template_quote_demo
